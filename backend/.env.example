# Local PostgreSQL
POSTGRES_USER=aiwse
POSTGRES_PASSWORD=aiwse_password
POSTGRES_DB=aiwse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aiwse:aiwse_password@localhost:5432/aiwse_db

# Local development auth
JWT_SECRET_KEY=change-me-to-a-long-local-secret
JWT_ALGORITHM=HS256

# Optional AI provider. Leave empty for the fully offline deterministic AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
UPLOAD_DIRECTORY=storage/submissions
